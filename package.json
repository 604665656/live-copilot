{
  "name": "danmu-ai-copilot",
  "version": "0.1.0",
  "description": "弹幕狼人杀 AI 主播助手 + 点歌姬",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DEBUG=1 electron .",
    "build": "electron-builder --win portable --x64"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.local.danmu.copilot",
    "productName": "DanmuAICopilot",
    "directories": {
      "output": "dist"
    },
  "files": [
    "main.js",
    "preload.js",
    "_director2.js",
    "_cdp.js",
    "_game_cdp_lib.js",
    "config.json",
    "src/**/*",
    "ui/**/*",
    "package.json"
  ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "弹幕AI主播助手.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  }
}
