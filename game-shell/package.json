{
    "name": "start",
    "version": "0.0.1",
    "main": "main.js",
    "scripts": {
        "start": "./node_modules/.bin/electron .",
        "buildexe": "electron-packager . start --platform=win32 --arch=x64 --icon=icon.ico --out=./out --app-version=0.0.1 --overwrite --ignore=node_modules",
        "build": "electron-packager . start --out=./out --asar --ignore=node_modules"
    },
    "dependencies": {
        "electron-packager": "^15.4.0",
        "electron-prebuilt": "^1.4.13"
    }
}
